<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GrandPrix.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GrandPrix.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <!--This is Temp UI-->
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">

        <!--greetings text-->
        <TextBlock Text="{Binding Greeting}"
                FontSize ="18"
                HorizontalAlignment="Center"/>
        
        <!--displays current student id-->
        <TextBlock Text="{Binding StudentId, Mode='TwoWay'}"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

        <!--allows the student to enter their ID, update it in code-->
        <TextBox Text="{Binding StudentId, Mode='TwoWay'}"
                    PlaceholderText="Enter Student ID"
                    PlaceholderForeground="Gray" />
        
        <!--submits the Student ID-->
        <Button Content="Submit"
                Command="{Binding SubmitAttendanceCommand}"
                HorizontalAlignment="Center"
                Padding="10,5"/>

    </StackPanel>
</UserControl>
